# Dependency directories
node_modules/
dist/

# Environment files
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploads directory (keep directory tracked with .gitkeep, ignore uploaded images)
/uploads/*
!/uploads/.gitkeep

# Temporary Office files
~$*
*.tmp

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
# Runtime database (recreated from seed data on startup)
data/lostconnect_db.json

# Editor settings
.vscode/
